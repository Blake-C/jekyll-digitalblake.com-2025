# Dependencies
/node_modules
/vendor

# Jekyll build output
_site/
_site_dev/
_build/

# Compiled assets and temporary files
tmp/
_includes/*.min.css.map

# Compiled CSS/JS — built by CI (pnpm run build:styles / build:scripts / hash-assets)
assets/css/*.min.css
assets/css/*.min.css.map
assets/js/*.min.js
_includes/critical.min.css

# Content-hashed font copies — regenerated by hash-assets on every build
# (the unhashed source WOFF2 stays committed)
assets/fonts/*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].woff2

# Generated asset manifest (rebuilt by hash-assets.mjs on every build)
_data/asset_manifest.json

# Secrets and local env (Search Console service-account key, etc.)
.env
/secrets/

# Node/package manager cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS and Editor files
.DS_Store
.vscode/
*.swp
TODO.todo
notes
.pnpm-store

# Article interview working files (article-interview skill): sources.md, the dictated
# interview.md, and draft.md, one directory per slug. Raw dictation and abandoned
# drafts, so they stay out of a public repo. The finished post goes in _posts.
_drafts/

# Copy to .env and fill in. .env is gitignored and loaded into the container by docker-compose.
# Used only by `pnpm run sync:search-console` (local, on-demand). Not needed for build or deploy.

# Search Console property URL — must match the registered property exactly (trailing slash).
GSC_SITE_URL=https://digitalblake.com/

# Path to the Google Cloud service-account JSON key, relative to the repo root.
# The service account's client_email must be added as a user on the property in Search Console.
# Default if unset: secrets/gsc-service-account.json (the secrets/ dir is gitignored).
GSC_SERVICE_ACCOUNT_KEY=secrets/gsc-service-account.json
